let currentLanguage = localStorage.getItem("habibi-language") || "id";

function applyLanguage(language) {
    currentLanguage = language;
    localStorage.setItem("habibi-language", language);

    document.documentElement.lang = language;

    document.querySelectorAll("[data-i18n]").forEach((element) => {
        const key = element.dataset.i18n;

        if (translations[language][key] !== undefined) {
            element.innerHTML = translations[language][key];
        }
    });

    const active = document.querySelector(".lang-active");

    if (active) {
        active.textContent = language.toUpperCase();
    }

    const nameInput = document.getElementById("name");
    const messageInput = document.getElementById("message");

    if (nameInput) {
        nameInput.placeholder = language === "id"
            ? "Nama Anda"
            : "Your name";
    }

    if (messageInput) {
        messageInput.placeholder = language === "id"
            ? "Ceritakan project Anda..."
            : "Tell us about your project...";
    }
}




/* ============================================================
   THEME SWITCHER
   ============================================================ */

function applyTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("habibi-theme", theme);

    const icon = document.querySelector(".theme-icon");
    const label = document.querySelector(".theme-label");

    if (!icon || !label) return;

    if (theme === "white") {
        icon.textContent = "☀";
        label.textContent = "WHITE";
    } else {
        icon.textContent = "☾";
        label.textContent = "BLACK";
    }
}

function initTheme() {
    const savedTheme = localStorage.getItem("habibi-theme") || "black";
    applyTheme(savedTheme);

    const themeSwitch = document.getElementById("themeSwitch");

    if (themeSwitch) {
        themeSwitch.addEventListener("click", () => {
            const current =
                document.documentElement.getAttribute("data-theme") || "black";

            applyTheme(current === "black" ? "white" : "black");
        });
    }
}


document.addEventListener("DOMContentLoaded", () => {

    applyLanguage(currentLanguage);
    initTheme();

    const loader = document.querySelector(".page-loader");

    setTimeout(() => {
        loader.classList.add("hide");
    }, 500);


    const menuToggle = document.getElementById("menuToggle");
    const navMenu = document.getElementById("navMenu");

    menuToggle.addEventListener("click", () => {
        navMenu.classList.toggle("open");
    });

    document.querySelectorAll(".nav-menu a").forEach((link) => {
        link.addEventListener("click", () => {
            navMenu.classList.remove("open");
        });
    });


    const languageSwitch = document.getElementById("languageSwitch");

    languageSwitch.addEventListener("click", () => {
        applyLanguage(currentLanguage === "id" ? "en" : "id");
    });


    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("visible");
                }
            });
        },
        {
            threshold: .12
        }
    );

    document.querySelectorAll(".reveal").forEach((element) => {
        observer.observe(element);
    });


    const form = document.getElementById("contactForm");

    form.addEventListener("submit", (event) => {
        event.preventDefault();

        const name = document.getElementById("name").value.trim();
        const project = document.getElementById("project").value;
        const message = document.getElementById("message").value.trim();

        if (!name || !project || !message) {
            return;
        }

        let whatsappMessage;

        if (currentLanguage === "id") {
            whatsappMessage =
                `Halo HABIBI.ID,%0A%0A` +
                `Nama: ${encodeURIComponent(name)}%0A` +
                `Jenis Project: ${encodeURIComponent(project)}%0A%0A` +
                `Pesan:%0A${encodeURIComponent(message)}`;
        } else {
            whatsappMessage =
                `Hello HABIBI.ID,%0A%0A` +
                `Name: ${encodeURIComponent(name)}%0A` +
                `Project Type: ${encodeURIComponent(project)}%0A%0A` +
                `Message:%0A${encodeURIComponent(message)}`;
        }

        window.open(
            `https://wa.me/6281934704296?text=${whatsappMessage}`,
            "_blank"
        );
    });


    document.getElementById("year").textContent = new Date().getFullYear();

});
